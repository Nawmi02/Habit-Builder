# Copy this file to .env and change the values.
#   Windows (PowerShell):  Copy-Item .env.example .env
#   Mac / Linux:           cp .env.example .env

SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost,10.0.2.2

# Running Django from VS Code (database in Docker):
DATABASE_URL=postgres://habit:habit@localhost:5432/habit_builder
REDIS_URL=redis://localhost:6379/0
# (docker-compose overrides these two with the db / redis service names)

# Teammates' models used by gamification. Leave empty until they exist.
# USER_REWARD_MODEL=rewards.UserReward
# STREAK_MODEL=streaks.Streak
